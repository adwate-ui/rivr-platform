---
// The HTML document around every page: document elements only. Every visible block is a React
// component from @rivr/ui, composed in a feature (additions, "Resolved conflicts").
import '@rivr/ui/styles.css';

interface Props {
  title: string;
  description?: string | null | undefined;
}

const { title, description } = Astro.props;
// The page's own address without the visitor's codes, for search engines and link previews (F3-30); a draft's preview
// page has none, as it is not the page.
const isPreview = Astro.url.pathname.startsWith('/preview/');
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const previewImage = new URL('/og-image.png', Astro.url.origin).href;
---

<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    {isPreview ? null : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    {isPreview ? null : <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <script>
      // The cookie banner (#616): open while this browser holds no choice. A choice is kept here, never sent anywhere,
      // and loads what it allows: the embedded map only once maps are allowed, and Google Tag Manager, with Google
      // Analytics and the Meta pixel inside it, only once analytics is (decision 0298).
      import { keepCookieChoice, loadTagManager, stopAnalytics, storedCookieChoice, type CookieChoice } from '@rivr/ui/cookies';

      const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
      const box = (name: string) => banner?.querySelector<HTMLInputElement>(`input[name="${name}"]`) ?? null;

      function load(choice: CookieChoice) {
        if (choice.analytics) loadTagManager();
        if (!choice.maps) return;
        for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-consent="maps"] iframe[data-consent-src]')) {
          frame.src = frame.dataset.consentSrc ?? '';
          frame.hidden = false;
          frame.parentElement?.querySelector('[data-consent-ask]')?.remove();
        }
      }

      function keep(choice: CookieChoice) {
        // Analytics turned off after it was on stops at once, its cookies gone (decision 0298).
        if (storedCookieChoice()?.analytics === true && !choice.analytics) {
          keepCookieChoice(choice);
          stopAnalytics();
          return;
        }
        keepCookieChoice(choice);
        load(choice);
        if (banner) banner.hidden = true;
      }

      const choice = storedCookieChoice();
      if (choice) load(choice);
      else if (banner) banner.hidden = false;

      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        // A link followed from the phone's Menu closes it, even one to a place on this page (W-03).
        if (target?.closest('nav a')) document.querySelector('header details[open]')?.removeAttribute('open');
        const button = target?.closest<HTMLElement>('[data-consent-choice]');
        if (button) {
          const kind = button.dataset.consentChoice;
          const ticked = (name: string) => kind === 'all' || (kind === 'ticked' && box(name)?.checked === true);
          keep({ maps: ticked('maps'), analytics: ticked('analytics') });
        } else if (target?.closest('[data-consent-allow="maps"]')) {
          keep({ maps: true, analytics: storedCookieChoice()?.analytics === true });
        } else if (target?.closest('[data-cookie-settings]') && banner) {
          for (const name of ['maps', 'analytics'] as const) {
            const checkbox = box(name);
            if (checkbox) checkbox.checked = storedCookieChoice()?.[name] === true;
          }
          // Asked for from the footer, the choices show open, not behind Choose.
          const choices = banner.querySelector('details');
          if (choices) choices.open = true;
          banner.hidden = false;
        }
      });

      // The hero's room video (WCAG 2.2.2): its button pauses it and plays it again, pressed while paused, and the choice
      // holds for the visit, page to page. Session storage can be refused; the button still works without it.
      const VIDEOS_PAUSED = 'rivr-videos-paused';
      function pauseVideos(isPaused: boolean) {
        for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-web-video-toggle]')) {
          const video = toggle.parentElement?.querySelector<HTMLVideoElement>('video[data-web-video]');
          if (isPaused) video?.pause();
          else void video?.play().catch(() => undefined);
          toggle.setAttribute('aria-pressed', String(isPaused));
          toggle.querySelector('[data-when-playing]')?.classList.toggle('hidden', isPaused);
          toggle.querySelector('[data-when-paused]')?.classList.toggle('hidden', !isPaused);
        }
      }
      try {
        if (sessionStorage.getItem(VIDEOS_PAUSED) === 'yes') pauseVideos(true);
      } catch {
        // No session storage: every page starts playing.
      }
      document.addEventListener('click', (event) => {
        const toggle = event.target instanceof Element ? event.target.closest('[data-web-video-toggle]') : null;
        if (toggle === null) return;
        const isPaused = toggle.getAttribute('aria-pressed') !== 'true';
        pauseVideos(isPaused);
        try {
          sessionStorage.setItem(VIDEOS_PAUSED, isPaused ? 'yes' : 'no');
        } catch {
          // Kept for this page only.
        }
      });
    </script>
  </body>
</html>
