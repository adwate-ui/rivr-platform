---
// Astro pages hold only document elements; every visible block is a React component from
// @rivr/ui, composed in a feature (additions, "Resolved conflicts").
import '@rivr/ui/styles.css';
import { createTranslator } from '@rivr/i18n';
import { HomePage } from '../features/home/index.ts';

const t = createTranslator('en');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('ui.brand.label')}</title>
  </head>
  <body>
    <HomePage />
  </body>
</html>
