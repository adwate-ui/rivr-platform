{
  "name": "rivr-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/turbo.mjs run dev",
    "build": "node scripts/turbo.mjs run build",
    "typecheck": "node scripts/turbo.mjs run typecheck",
    "lint": "node scripts/turbo.mjs run lint && pnpm lint:root && pnpm lint:deps && pnpm lint:css",
    "lint:root": "eslint scripts e2e load supabase/functions eslint.config.js stylelint.config.mjs playwright.config.ts --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:css": "stylelint \"**/*.{css,scss,sass,less}\" --allow-empty-input",
    "test": "node scripts/turbo.mjs run test",
    "e2e": "node scripts/turbo.mjs run build --filter './apps/*' --output-logs=errors-only && playwright test",
    "visual": "node scripts/turbo.mjs run visual",
    "storybook": "node scripts/turbo.mjs run storybook",
    "supabase": "node scripts/supabase.mjs",
    "db:start": "node scripts/supabase.mjs start",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset",
    "db:types": "node scripts/db-types.mjs",
    "verify": "node scripts/verify.mjs changed",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:all": "node scripts/verify.mjs all"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rivr/config": "workspace:*",
    "@rivr/tokens": "workspace:*",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "stylelint": "^17.16.0",
    "supabase": "^2.121.0",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.1"
  }
}
