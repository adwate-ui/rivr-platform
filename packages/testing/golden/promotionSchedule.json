      "inputs": { "schedule": "{\"days\": [1, 2, 3, 4, 5, 6, 7], \"from\": \"06:00\", \"to\": \"06:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-17T22:00:00+05:30", "to": "2026-11-18T04:00:00+05:30" },
