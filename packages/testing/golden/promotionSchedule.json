      "operation": "in",
      "inputs": { "schedule": "{\"days\": [2], \"from\": \"02:00\", \"to\": \"05:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "at": "2026-11-17T03:00:00+05:30" },
      "expected": { "inSchedule": "no" }
    },
    {
