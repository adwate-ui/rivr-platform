      "description": "The start day: starting Saturday, played 21:00 Friday to 01:00 Sunday, only Saturday's five hours to 01:00 count.",
      "operation": "seconds",
      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-21\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-20T21:00:00+05:30", "to": "2026-11-22T01:00:00+05:30" },
      "expected": { "seconds": "18000" }
    },
