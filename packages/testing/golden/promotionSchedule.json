      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-01\", \"endsOn\": \"2026-11-20\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-20T21:00:00+05:30", "to": "2026-11-22T01:00:00+05:30" },
      "expected": { "seconds": "18000" }
