      "operation": "seconds",
      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-20T23:00:00+05:30", "to": "2026-11-21T01:00:00+05:30" },
      "expected": { "seconds": "7200" }
    },
    {
      "description": "Played on Thursday, which is not one of its days: nothing counts.",
      "operation": "seconds",
      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-19T19:00:00+05:30", "to": "2026-11-19T23:00:00+05:30" },
      "expected": { "seconds": "0" }
    },
    {
      "description": "Played 18:00 Friday to 03:00 Sunday: Friday's and Saturday's openings, six hours each.",
      "operation": "seconds",
      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-20T18:00:00+05:30", "to": "2026-11-22T03:00:00+05:30" },
      "expected": { "seconds": "43200" }
    },
