      "expected": { "inSchedule": "yes" }
    },
    {
      "description": "Friday 20:00 to 02:00, played 19:00 Friday to 03:00 Saturday: the six hours inside count.",
      "operation": "seconds",
      "inputs": { "schedule": "{\"days\": [5, 6], \"from\": \"20:00\", \"to\": \"02:00\", \"startsOn\": \"2026-11-01\", \"timezone\": \"Asia/Kolkata\"}", "from": "2026-11-20T19:00:00+05:30", "to": "2026-11-21T03:00:00+05:30" },
      "expected": { "seconds": "21600" }
    },
