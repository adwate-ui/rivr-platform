      "inputs": { "conditions": "{\"days\": [2]}", "facts": "{\"at\": \"2026-11-18T06:00:00+05:30\"}" },
      "expected": { "applies": "no" }
    },
    {
      "description": "Weekends: Sunday is day 7.",
