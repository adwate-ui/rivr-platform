      "inputs": { "conditions": "{\"days\": [4], \"from\": \"14:00\", \"until\": \"20:00\"}", "facts": "{\"at\": \"2026-11-19T14:00:00+05:30\"}" },
      "expected": { "applies": "yes" }
    },
    {
      "description": "Thursday 14:00 to 20:00: 19:59 is inside.",
      "operation": "applies",
      "inputs": { "conditions": "{\"days\": [4], \"from\": \"14:00\", \"until\": \"20:00\"}", "facts": "{\"at\": \"2026-11-19T19:59:00+05:30\"}" },
      "expected": { "applies": "yes" }
    },
    {
      "description": "Thursday 14:00 to 20:00: at 20:00 the window has closed.",
      "operation": "applies",
      "inputs": { "conditions": "{\"days\": [4], \"from\": \"14:00\", \"until\": \"20:00\"}", "facts": "{\"at\": \"2026-11-19T20:00:00+05:30\"}" },
      "expected": { "applies": "no" }
    },
    {
      "description": "Thursday 14:00 to 20:00: 13:59 is before it.",
      "operation": "applies",
      "inputs": { "conditions": "{\"days\": [4], \"from\": \"14:00\", \"until\": \"20:00\"}", "facts": "{\"at\": \"2026-11-19T13:59:00+05:30\"}" },
      "expected": { "applies": "no" }
    },
    {
      "description": "A late window, 22:00 to 04:00 on Saturday night: 03:59 on Sunday morning is inside.",
      "operation": "applies",
      "inputs": { "conditions": "{\"days\": [6], \"from\": \"22:00\", \"until\": \"04:00\"}", "facts": "{\"at\": \"2026-11-15T03:59:00+05:30\"}" },
      "expected": { "applies": "yes" }
    },
    {
      "description": "A late window, 22:00 to 04:00: at 04:00 it has closed.",
