{
  "rule": "promotionSimulation",
  "about": "Simulating a promotion on last week (scope-v1 module 7 controls; #144). The builder's choices become the promotion's rule, as publishing makes it. Each of last week's events is weighed in time order, as the engine weighs it live: a buy-in (its own money; one paid from bonus is ₹0) or a closed visit's hours played (its points earned, and for a rule with days or times only the time inside its window, so such a rule's days, times and stake are then met). A grant is given when the rule applies and its reward comes to something, while the first-N count for the club day, the per-player limit and the budget allow: a grant is whole or not at all. Club days run 06:00 to 06:00 IST. The result is the grants, the members who got one, the rupee cost (a bonus; points cost nothing), the extra points, what is left of a rupee budget and whether the budget stopped a grant. An event with \"times\": N stands for N such events by N different members, m1 to mN.",
  "cases": [
    {
      "description": "Flow 7's Thursday scheme: double points at 100/200, 14:00 to 20:00. Two players' time inside the window earned 120 and 30 points: 150 more, at no rupee cost.",
      "operation": "simulate",
      "inputs": {
        "choices": "{\"days\": [4], \"from\": \"14:00\", \"until\": \"20:00\", \"stake\": \"nlh_100_200\", \"reward\": \"double_points\", \"limit\": \"none\", \"bonus_cap_rupees\": 5000}",
        "budget": "none",
        "events": "[{\"at\": \"2026-11-19T20:30:00+05:30\", \"member\": \"arjun\", \"table\": \"t3\", \"stake\": \"nlh_100_200\", \"points\": 120, \"hours_played\": 6}, {\"at\": \"2026-11-19T21:10:00+05:30\", \"member\": \"kabir\", \"table\": \"t3\", \"stake\": \"nlh_100_200\", \"points\": 30, \"hours_played\": 1.5}]"
      },
      "expected": { "grants": "2", "members": "2", "cost": "₹0", "points": "150", "budget_left": "no cap", "budget_reached": "no" }
    },
    {
      "description": "Triple points on 60 points earned is 120 more.",
      "operation": "simulate",
      "inputs": {
        "choices": "{\"days\": [], \"from\": null, \"until\": null, \"stake\": null, \"reward\": \"triple_points\", \"limit\": \"none\", \"bonus_cap_rupees\": 5000}",
        "budget": "none",
        "events": "[{\"at\": \"2026-11-17T23:00:00+05:30\", \"member\": \"naina\", \"table\": \"t1\", \"stake\": \"nlh_25_50\", \"points\": 60, \"hours_played\": 3}]"
      },
      "expected": { "grants": "1", "members": "1", "cost": "₹0", "points": "120", "budget_left": "no cap", "budget_reached": "no" }
    },
