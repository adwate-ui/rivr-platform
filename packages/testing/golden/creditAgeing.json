{
  "rule": "marker ageing and repayment",
  "about": "Credit at the cage (#92; scope-v1 module 5). A marker's age is the whole days since it was issued, counted down; the credit report sorts what each open marker still owes into 0 to 7 days, 8 to 30, 31 to 60 and over 60. A repayment, by cash or UPI, in whole ₹50 chips above nothing, settles the member's open markers oldest first, each as far as it goes, as a cash-out's chips do, and never more than they owe in all.",
  "cases": [
    { "description": "Issued just now: 0 days old.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2026-11-15T20:00:00+05:30" }, "expected": { "bucket": "0_7" } },
    { "description": "7 days and 23 hours: still 7 days old, the first bucket's last.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2026-11-23T19:00:00+05:30" }, "expected": { "bucket": "0_7" } },
    { "description": "8 days to the minute: the second bucket.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2026-11-23T20:00:00+05:30" }, "expected": { "bucket": "8_30" } },
    { "description": "30 days: still the second bucket.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2026-12-15T20:00:00+05:30" }, "expected": { "bucket": "8_30" } },
    { "description": "31 days: the third.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2026-12-16T20:00:00+05:30" }, "expected": { "bucket": "31_60" } },
    { "description": "60 days: still the third.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2027-01-14T20:00:00+05:30" }, "expected": { "bucket": "31_60" } },
    { "description": "61 days: over 60.", "operation": "bucket",
      "inputs": { "issued": "2026-11-15T20:00:00+05:30", "at": "2027-01-15T20:00:00+05:30" }, "expected": { "bucket": "over_60" } },
    { "description": "Issued after the moment asked about: 0 days old.", "operation": "bucket",
      "inputs": { "issued": "2026-11-16T20:00:00+05:30", "at": "2026-11-15T20:00:00+05:30" }, "expected": { "bucket": "0_7" } },
    { "description": "₹30,000 against ₹50,000 then ₹20,000 owed: part of the oldest.", "operation": "repay",
      "inputs": { "amount": "₹30,000", "markers": "₹50,000 | ₹20,000" }, "expected": { "settled": "₹30,000" } },
    { "description": "₹60,000: the oldest in full, then part of the next.", "operation": "repay",
      "inputs": { "amount": "₹60,000", "markers": "₹50,000 | ₹20,000" }, "expected": { "settled": "₹50,000 | ₹10,000" } },
    { "description": "Exactly all that is owed.", "operation": "repay",
      "inputs": { "amount": "₹70,000", "markers": "₹50,000 | ₹20,000" }, "expected": { "settled": "₹50,000 | ₹20,000" } },
    { "description": "One chip more than is owed is refused.", "operation": "repay",
      "inputs": { "amount": "₹70,050", "markers": "₹50,000 | ₹20,000" }, "expected": { "settled": "more_than_owed" } },
    { "description": "At a ₹50 boundary: ₹50 is one chip and settles ₹50.", "operation": "repay",
      "inputs": { "amount": "₹50", "markers": "₹50,000" }, "expected": { "settled": "₹50" } },
    { "description": "Not whole chips: ₹10,020 is refused.", "operation": "repay",
      "inputs": { "amount": "₹10,020", "markers": "₹50,000" }, "expected": { "settled": "not_chips" } },
    { "description": "Nothing is refused.", "operation": "repay",
      "inputs": { "amount": "₹0", "markers": "₹50,000" }, "expected": { "settled": "not_chips" } },
    { "description": "Nothing owed: a repayment is refused.", "operation": "repay",
      "inputs": { "amount": "₹5,000", "markers": "" }, "expected": { "settled": "nothing_owed" } }
  ]
}
