{
  "rule": "bonus",
  "about": "A bonus balance (scope-v1 module 5; #17): each grant has an amount and an end, or none: bonus chips given since decision 0504 never end (written @ never). Bonus is playable, not withdrawable: it buys chips, in whole ₹50 chips above nothing, drawn from the grants in force, the soonest to end first and those with no end last (in the order listed when two end together or neither ends: the oldest first), each as far as it goes; more than the bonus in force is refused. A grant is in force before its end, never at it: at its end its remainder expires and is reversed. A grant with no end is always in force and never expires. Grants are listed as amount @ end, separated by |; what each grant gives, or what expires of it, is listed in the same order. Nothing is rounded.",
  "cases": [
    {
      "description": "₹2,000 from Arjun's ₹4,000 bonus expiring Sunday: half of it, ₹2,000 left.",
      "operation": "spend",
      "inputs": { "amount": "₹2,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-23T06:00:00+05:30" },
      "expected": { "taken": "₹2,000" }
    },
    {
      "description": "Partial use across two grants: the one ending first goes first, then the rest from the later one.",
      "operation": "spend",
      "inputs": { "amount": "₹5,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹3,000 | ₹2,000" }
    },
    {
      "description": "At its end a grant is no longer in force: the ₹2,000 ending now gives nothing, the rest comes from the later one.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-20T06:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹0" }
    },
    {
      "description": "A second before its end a grant is still in force, and goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-20T05:59:59+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹0 | ₹1,000" }
    },
    {
      "description": "Two grants ending together: the one listed first goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹2,000 @ 2026-11-23T06:00:00+05:30 | ₹2,000 @ 2026-11-23T06:00:00+05:30" },
      "expected": { "taken": "₹2,000 | ₹1,000" }
    },
    {
      "description": "Exactly all the bonus in force: every grant to nothing.",
      "operation": "spend",
      "inputs": { "amount": "₹6,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹4,000 | ₹2,000" }
    },
    {
      "description": "More than the bonus in force is refused: an expired grant does not count.",
      "operation": "spend",
      "inputs": { "amount": "₹5,000", "at": "2026-11-25T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "Not whole ₹50 chips: refused.",
      "operation": "spend",
      "inputs": { "amount": "₹1,020", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "Nothing is not a spend.",
      "operation": "spend",
      "inputs": { "amount": "₹0", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "No bonus at all: any spend is refused.",
      "operation": "spend",
      "inputs": { "amount": "₹500", "at": "2026-11-15T20:00:00+05:30", "grants": "" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "At its end, a grant's remainder expires; one still in force does not.",
      "operation": "expire",
      "inputs": { "at": "2026-11-20T06:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹2,000" }
    },
    {
      "description": "A second before its end, nothing expires.",
      "operation": "expire",
      "inputs": { "at": "2026-11-20T05:59:59+05:30", "grants": "₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0" }
    },
    {
      "description": "A grant used up expires nothing.",
      "operation": "expire",
      "inputs": { "at": "2026-11-25T06:00:00+05:30", "grants": "₹0 @ 2026-11-20T06:00:00+05:30 | ₹1,500 @ 2026-11-21T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹1,500" }
    },
    {
      "description": "A grant with no end: ₹1,000 from a ₹1,500 welcome bonus, ₹500 left.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹1,500 @ never" },
      "expected": { "taken": "₹1,000" }
    },
    {
      "description": "A grant with no end is still in force ten years on.",
      "operation": "spend",
      "inputs": { "amount": "₹500", "at": "2036-11-15T20:00:00+05:30", "grants": "₹500 @ never" },
      "expected": { "taken": "₹500" }
    },
    {
      "description": "A grant that ends goes before one that never does.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹2,000" }
    },
    {
      "description": "Two grants with no end: the one listed first (the oldest) goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹2,000 @ never | ₹2,000 @ never" },
      "expected": { "taken": "₹2,000 | ₹1,000" }
    },
    {
      "description": "The whole balance of grants with no end: every grant to nothing.",
      "operation": "spend",
      "inputs": { "amount": "₹6,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ never" },
      "expected": { "taken": "₹4,000 | ₹2,000" }
    },
    {
      "description": "One ₹50 chip, the smallest spend, from a grant of exactly ₹50 with no end.",
      "operation": "spend",
      "inputs": { "amount": "₹50", "at": "2026-11-15T20:00:00+05:30", "grants": "₹50 @ never" },
      "expected": { "taken": "₹50" }
    },
    {
      "description": "₹50 more than a grant with no end holds is refused.",
      "operation": "spend",
      "inputs": { "amount": "₹100", "at": "2026-11-15T20:00:00+05:30", "grants": "₹50 @ never" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "Nothing is not a spend, from a grant with no end either.",
      "operation": "spend",
      "inputs": { "amount": "₹0", "at": "2026-11-15T20:00:00+05:30", "grants": "₹1,500 @ never" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "A grant with no end never expires; a dated one beside it does at its end.",
      "operation": "expire",
      "inputs": { "at": "2036-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹2,000" }
    }
  ]
}
