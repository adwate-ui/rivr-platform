{
  "rule": "bonus",
  "about": "A bonus balance (scope-v1 module 5; #17): each grant has an amount and an end, or none: bonus chips given since decision 0504 never end (written @ never). Bonus is playable, not withdrawable: it buys chips, in whole ₹50 chips above nothing, drawn from the grants in force, the soonest to end first and those with no end last (in the order listed when two end together or neither ends: the oldest first), each as far as it goes; more than the bonus in force is refused. A grant is in force before its end, never at it: at its end its remainder expires and is reversed. A grant with no end is always in force and never expires. Grants are listed as amount @ end, separated by |; what each grant gives, or what expires of it, is listed in the same order. Nothing is rounded. Since 12 Nov (decision 0579) a venue can make bonus chips end N days after they are given (end), chips held when it is switched on ending N days from then, and none with it off (0 days); and can let a visit redeem only x% of the bonus held at its first seat, in whole ₹50 chips (visitCap), less what the visit has redeemed (visitLeft).",
  "cases": [
    {
      "description": "₹2,000 from Arjun's ₹4,000 bonus expiring Sunday: half of it, ₹2,000 left.",
      "operation": "spend",
      "inputs": { "amount": "₹2,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-23T06:00:00+05:30" },
      "expected": { "taken": "₹2,000" }
    },
    {
      "description": "Partial use across two grants: the one ending first goes first, then the rest from the later one.",
      "operation": "spend",
      "inputs": { "amount": "₹5,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹3,000 | ₹2,000" }
    },
    {
      "description": "At its end a grant is no longer in force: the ₹2,000 ending now gives nothing, the rest comes from the later one.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-20T06:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹0" }
    },
    {
      "description": "A second before its end a grant is still in force, and goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-20T05:59:59+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹0 | ₹1,000" }
    },
    {
      "description": "Two grants ending together: the one listed first goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹2,000 @ 2026-11-23T06:00:00+05:30 | ₹2,000 @ 2026-11-23T06:00:00+05:30" },
      "expected": { "taken": "₹2,000 | ₹1,000" }
    },
    {
      "description": "Exactly all the bonus in force: every grant to nothing.",
      "operation": "spend",
      "inputs": { "amount": "₹6,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹4,000 | ₹2,000" }
    },
    {
      "description": "More than the bonus in force is refused: an expired grant does not count.",
      "operation": "spend",
      "inputs": { "amount": "₹5,000", "at": "2026-11-25T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "Not whole ₹50 chips: refused.",
      "operation": "spend",
      "inputs": { "amount": "₹1,020", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "Nothing is not a spend.",
      "operation": "spend",
      "inputs": { "amount": "₹0", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "No bonus at all: any spend is refused.",
      "operation": "spend",
      "inputs": { "amount": "₹500", "at": "2026-11-15T20:00:00+05:30", "grants": "" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "At its end, a grant's remainder expires; one still in force does not.",
      "operation": "expire",
      "inputs": { "at": "2026-11-20T06:00:00+05:30", "grants": "₹4,000 @ 2026-11-30T06:00:00+05:30 | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹2,000" }
    },
    {
      "description": "A second before its end, nothing expires.",
      "operation": "expire",
      "inputs": { "at": "2026-11-20T05:59:59+05:30", "grants": "₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0" }
    },
    {
      "description": "A grant used up expires nothing.",
      "operation": "expire",
      "inputs": { "at": "2026-11-25T06:00:00+05:30", "grants": "₹0 @ 2026-11-20T06:00:00+05:30 | ₹1,500 @ 2026-11-21T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹1,500" }
    },
    {
      "description": "A grant with no end: ₹1,000 from a ₹1,500 welcome bonus, ₹500 left.",
      "operation": "spend",
      "inputs": { "amount": "₹1,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹1,500 @ never" },
      "expected": { "taken": "₹1,000" }
    },
    {
      "description": "A grant with no end is still in force ten years on.",
      "operation": "spend",
      "inputs": { "amount": "₹500", "at": "2036-11-15T20:00:00+05:30", "grants": "₹500 @ never" },
      "expected": { "taken": "₹500" }
    },
    {
      "description": "A grant that ends goes before one that never does.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹2,000" }
    },
    {
      "description": "Two grants with no end: the one listed first (the oldest) goes first.",
      "operation": "spend",
      "inputs": { "amount": "₹3,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹2,000 @ never | ₹2,000 @ never" },
      "expected": { "taken": "₹2,000 | ₹1,000" }
    },
    {
      "description": "The whole balance of grants with no end: every grant to nothing.",
      "operation": "spend",
      "inputs": { "amount": "₹6,000", "at": "2026-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ never" },
      "expected": { "taken": "₹4,000 | ₹2,000" }
    },
    {
      "description": "One ₹50 chip, the smallest spend, from a grant of exactly ₹50 with no end.",
      "operation": "spend",
      "inputs": { "amount": "₹50", "at": "2026-11-15T20:00:00+05:30", "grants": "₹50 @ never" },
      "expected": { "taken": "₹50" }
    },
    {
      "description": "₹50 more than a grant with no end holds is refused.",
      "operation": "spend",
      "inputs": { "amount": "₹100", "at": "2026-11-15T20:00:00+05:30", "grants": "₹50 @ never" },
      "expected": { "taken": "bonus_short" }
    },
    {
      "description": "Nothing is not a spend, from a grant with no end either.",
      "operation": "spend",
      "inputs": { "amount": "₹0", "at": "2026-11-15T20:00:00+05:30", "grants": "₹1,500 @ never" },
      "expected": { "taken": "not_chips" }
    },
    {
      "description": "A grant with no end never expires; a dated one beside it does at its end.",
      "operation": "expire",
      "inputs": { "at": "2036-11-15T20:00:00+05:30", "grants": "₹4,000 @ never | ₹2,000 @ 2026-11-20T06:00:00+05:30" },
      "expected": { "expired": "₹0 | ₹2,000" }
    },
    {
      "description": "Expiry after 30 days: a grant given on Sunday night ends 30 days later, at the same time.",
      "operation": "end",
      "inputs": { "given": "2026-11-15T20:00:00+05:30", "days": "30", "since": "2026-11-13T00:00:00+05:30" },
      "expected": { "ends": "2026-12-15T20:00:00+05:30" }
    },
    {
      "description": "Chips held when expiry was switched on end 30 days from the switch-on, not from when they were given.",
      "operation": "end",
      "inputs": { "given": "2026-11-01T20:00:00+05:30", "days": "30", "since": "2026-11-13T00:00:00+05:30" },
      "expected": { "ends": "2026-12-13T00:00:00+05:30" }
    },
    {
      "description": "One day: a grant ends at the same time the next day.",
      "operation": "end",
      "inputs": { "given": "2026-11-15T23:30:00+05:30", "days": "1", "since": "2026-11-13T00:00:00+05:30" },
      "expected": { "ends": "2026-11-16T23:30:00+05:30" }
    },
    {
      "description": "Expiry off (0 days): a grant never ends.",
      "operation": "end",
      "inputs": { "given": "2026-11-15T20:00:00+05:30", "days": "0", "since": "2026-11-13T00:00:00+05:30" },
      "expected": { "ends": "never" }
    },
    {
      "description": "Half of a ₹10,000 balance at the visit's first Bonus use: ₹5,000 this visit.",
      "operation": "visitCap",
      "inputs": { "held": "₹10,000", "basisPoints": "5000" },
      "expected": { "cap": "₹5,000" }
    },
    {
      "description": "Half of ₹1,250 is ₹625, which rounds down to whole ₹50 chips: ₹600.",
      "operation": "visitCap",
      "inputs": { "held": "₹1,250", "basisPoints": "5000" },
      "expected": { "cap": "₹600" }
    },
    {
      "description": "Half of ₹1,300 is ₹650, already whole ₹50 chips.",
      "operation": "visitCap",
      "inputs": { "held": "₹1,300", "basisPoints": "5000" },
      "expected": { "cap": "₹650" }
    },
    {
      "description": "At 100%, the whole balance in whole ₹50 chips: ₹1,275.50 gives ₹1,250.",
      "operation": "visitCap",
      "inputs": { "held": "₹1,275.50", "basisPoints": "10000" },
      "expected": { "cap": "₹1,250" }
    },
    {
      "description": "Nothing held at the visit's first Bonus use: nothing this visit.",
      "operation": "visitCap",
      "inputs": { "held": "₹0", "basisPoints": "5000" },
      "expected": { "cap": "₹0" }
    },
    {
      "description": "A ₹5,000 cap with ₹2,000 redeemed: ₹3,000 left.",
      "operation": "visitLeft",
      "inputs": { "cap": "₹5,000", "redeemed": "₹2,000" },
      "expected": { "left": "₹3,000" }
    },
    {
      "description": "The cap reached: nothing left.",
      "operation": "visitLeft",
      "inputs": { "cap": "₹5,000", "redeemed": "₹5,000" },
      "expected": { "left": "₹0" }
    },
    {
      "description": "Never below nothing, even past the cap.",
      "operation": "visitLeft",
      "inputs": { "cap": "₹5,000", "redeemed": "₹5,500" },
      "expected": { "left": "₹0" }
    },
    {
      "description": "A cap of nothing and nothing redeemed: nothing left.",
      "operation": "visitLeft",
      "inputs": { "cap": "₹0", "redeemed": "₹0" },
      "expected": { "left": "₹0" }
    },
    {
      "description": "Arjun's ₹4,000 Bonus reversed with ₹2,500 of it left and ₹1,000 of another: ₹2,500 from it, ₹1,000 from the other, ₹500 owed.",
      "operation": "take",
      "inputs": { "amount": "₹4,000", "grants": "₹2,500 @ never | ₹1,000 @ never", "first": "1", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹2,500 | ₹1,000", "owed": "₹500" }
    },
    {
      "description": "A ₹3,000 Bonus reversed unspent: all of it from itself, nothing from the other, nothing owed.",
      "operation": "take",
      "inputs": { "amount": "₹3,000", "grants": "₹1,000 @ never | ₹3,000 @ never", "first": "2", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹0 | ₹3,000", "owed": "₹0" }
    },
    {
      "description": "A ₹2,000 Bonus reversed once all spent, with no other Bonus: ₹2,000 owed.",
      "operation": "take",
      "inputs": { "amount": "₹2,000", "grants": "₹0 @ never", "first": "1", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹0", "owed": "₹2,000" }
    },
    {
      "description": "After the grant reversed, the others soonest to end first: ₹500 from it, ₹1,000 ending the 25th, ₹500 of the one ending the 30th.",
      "operation": "take",
      "inputs": { "amount": "₹2,000", "grants": "₹500 @ never | ₹1,000 @ 2026-11-30T06:00:00+05:30 | ₹1,000 @ 2026-11-25T06:00:00+05:30", "first": "1", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹500 | ₹500 | ₹1,000", "owed": "₹0" }
    },
    {
      "description": "The grant reversed gives what is left of it though it has ended: that goes back now, not again at expiry.",
      "operation": "take",
      "inputs": { "amount": "₹1,000", "grants": "₹1,000 @ 2026-11-10T06:00:00+05:30 | ₹2,000 @ never", "first": "1", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹0", "owed": "₹0" }
    },
    {
      "description": "A ₹25,000 reversal with ₹20,000 of it left and nothing else: ₹5,000 owed.",
      "operation": "take",
      "inputs": { "amount": "₹25,000", "grants": "₹20,000 @ never", "first": "1", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹20,000", "owed": "₹5,000" }
    },
    {
      "description": "A use added after the fact within the balance: ₹1,500 of ₹3,000.",
      "operation": "take",
      "inputs": { "amount": "₹1,500", "grants": "₹3,000 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹1,500", "owed": "₹0" }
    },
    {
      "description": "A use added beyond the balance: all ₹1,000 of it, and ₹500 owed.",
      "operation": "take",
      "inputs": { "amount": "₹1,500", "grants": "₹1,000 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹1,000", "owed": "₹500" }
    },
    {
      "description": "An ended grant gives nothing to a use added: ₹500 from the one in force, ₹500 owed.",
      "operation": "take",
      "inputs": { "amount": "₹1,000", "grants": "₹1,000 @ 2026-11-10T06:00:00+05:30 | ₹500 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹0 | ₹500", "owed": "₹500" }
    },
    {
      "description": "Exactly the balance: every grant to nothing, nothing owed.",
      "operation": "take",
      "inputs": { "amount": "₹1,500", "grants": "₹1,000 @ never | ₹500 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹1,000 | ₹500", "owed": "₹0" }
    },
    {
      "description": "A ₹1,550 use with ₹1,234.56 held: all of it, ₹315.44 owed.",
      "operation": "take",
      "inputs": { "amount": "₹1,550", "grants": "₹1,234.56 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹1,234.56", "owed": "₹315.44" }
    },
    {
      "description": "One ₹50 chip with no Bonus at all: ₹50 owed.",
      "operation": "take",
      "inputs": { "amount": "₹50", "grants": "", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "", "owed": "₹50" }
    },
    {
      "description": "Nothing taken back: nothing from any grant, nothing owed.",
      "operation": "take",
      "inputs": { "amount": "₹0", "grants": "₹1,000 @ never", "first": "none", "at": "2026-11-19T20:00:00+05:30" },
      "expected": { "taken": "₹0", "owed": "₹0" }
    },
    {
      "description": "₹1,000 given with ₹500 owed: ₹500 pays it, ₹500 kept.",
      "operation": "payOff",
      "inputs": { "given": "₹1,000", "owed": "₹500" },
      "expected": { "paid": "₹500", "kept": "₹500" }
    },
    {
      "description": "₹500 given with ₹500 owed: all of it pays it, nothing kept.",
      "operation": "payOff",
      "inputs": { "given": "₹500", "owed": "₹500" },
      "expected": { "paid": "₹500", "kept": "₹0" }
    },
    {
      "description": "₹500 given with ₹2,000 owed: all of it pays, ₹1,500 still owed.",
      "operation": "payOff",
      "inputs": { "given": "₹500", "owed": "₹2,000" },
      "expected": { "paid": "₹500", "kept": "₹0" }
    },
    {
      "description": "Nothing owed: all ₹1,000 kept.",
      "operation": "payOff",
      "inputs": { "given": "₹1,000", "owed": "₹0" },
      "expected": { "paid": "₹0", "kept": "₹1,000" }
    },
    {
      "description": "₹50 given with ₹15.44 owed: ₹15.44 pays it, ₹34.56 kept.",
      "operation": "payOff",
      "inputs": { "given": "₹50", "owed": "₹15.44" },
      "expected": { "paid": "₹15.44", "kept": "₹34.56" }
    },
    {
      "description": "One ₹50 chip given with ₹50 owed: paid, nothing kept.",
      "operation": "payOff",
      "inputs": { "given": "₹50", "owed": "₹50" },
      "expected": { "paid": "₹50", "kept": "₹0" }
    },
    {
      "description": "Nothing given: nothing paid, nothing kept.",
      "operation": "payOff",
      "inputs": { "given": "₹0", "owed": "₹500" },
      "expected": { "paid": "₹0", "kept": "₹0" }
    }
  ]
}
