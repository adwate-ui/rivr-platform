{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["generated/**"]
    },
    // src/generated.test.ts reads this package's own build output, so the build runs first.
    "test": {
      "dependsOn": ["^build", "build"]
    }
  }
}
