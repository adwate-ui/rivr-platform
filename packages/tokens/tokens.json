{
  "$description": "RIVR design tokens, the single source of every design value (W3C Design Tokens format). Values come from docs/design/design-inventory.md. Edit here, then run `pnpm --filter @rivr/tokens build`.",
  "color": {
    "$type": "color",
    "green": { "$value": "#0E3B2C", "$description": "Deep green. Primary background on every surface." },
    "greenBlack": { "$value": "#0A2A20", "$description": "Green-black. Raised surfaces, nav bars, table rows on hover." },
    "cream": { "$value": "#F3EDE0", "$description": "Primary text and the wordmark tiles." },
    "gold": { "$value": "#C9A85C", "$description": "The one primary action per screen, money that belongs to the player, hairlines at 25%." },
    "red": { "$value": "#C4162A", "$description": "Alerts, negatives, the spade card in the mark. Nothing else." },
    "ink": { "$value": "#141414", "$description": "Text on cream tiles only." },
    "muted": { "$value": "#F3EDE099", "$description": "Cream at 60%. Secondary text; at least 4.5:1 on green." },
    "hairline": { "$value": "#C9A85C40", "$description": "Gold at 25%. The 1 px rules that separate content." },
    "surface": { "$value": "{color.green}", "$description": "Page background." },
    "raised": { "$value": "{color.greenBlack}", "$description": "Raised surfaces: nav bars, rails, sheets, row hover." },
    "content": { "$value": "{color.cream}", "$description": "Primary text and icons." },
    "contentMuted": { "$value": "{color.muted}", "$description": "Secondary text." },
    "onCream": { "$value": "{color.ink}", "$description": "Text on a cream tile." },
    "action": { "$value": "{color.gold}", "$description": "Fill of the one primary action on a screen." },
    "onAction": { "$value": "{color.greenBlack}", "$description": "Text on the primary action." },
    "money": { "$value": "{color.gold}", "$description": "Money that belongs to the player." },
    "alert": { "$value": "{color.red}", "$description": "Alert and danger fills, negative markers." },
    "onAlert": { "$value": "{color.cream}", "$description": "Text on an alert fill." },
    "focus": { "$value": "{color.cream}", "$description": "Keyboard focus ring." },
    "chart": {
      "$description": "Series colours for charts, in order. Each reads at 3:1 or better on green.",
      "1": { "$value": "{color.gold}" },
      "2": { "$value": "{color.cream}" },
      "3": { "$value": "#7FC8A9", "$description": "Mint." },
      "4": { "$value": "#8DB8E0", "$description": "Sky." },
      "5": { "$value": "#E88B7D", "$description": "Coral." },
      "6": { "$value": "#B9A4D8", "$description": "Lilac." }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Bodoni Moda", "Tiro Devanagari Hindi", "serif"],
        "$description": "Display only: wordmark, TV titles, the jackpot figure. Never below 20 px. Tiro Devanagari Hindi sets Hindi."
      },
      "text": {
        "$value": ["Instrument Sans", "Noto Sans Devanagari", "sans-serif"],
        "$description": "Everything else. Noto Sans Devanagari sets Hindi."
      }
    },
    "size": {
      "$type": "dimension",
      "12": { "$value": "12px" },
      "13": { "$value": "13px" },
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "28": { "$value": "28px" },
      "36": { "$value": "36px" },
      "44": { "$value": "44px" },
      "56": { "$value": "56px" },
      "96": { "$value": "96px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.1, "$description": "Display sizes, 28 px and up." },
      "snug": { "$value": 1.3, "$description": "Headings, 18 to 24 px." },
      "normal": { "$value": 1.5, "$description": "Body text." }
    },
    "letterSpacing": {
      "$type": "dimension",
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.06em", "$description": "Small capitals labels." },
      "tv": { "$value": "0.2em", "$description": "Letter-spaced labels on the TV and under the wordmark." }
    },
    "figures": {
      "$description": "Numbers always use tabular figures.",
      "numeric": { "$value": "tabular-nums" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale on a 4 px grid. Separation comes from spacing and hairlines, not boxes.",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "44px", "$description": "Minimum touch target on the player app and the dealer tablet." },
    "rail": { "$value": "248px", "$description": "Console left rail." },
    "bottomNav": { "$value": "64px", "$description": "Player bottom tab bar." },
    "header": { "$value": "56px", "$description": "Top bar on phone and tablet shells." },
    "text": { "$value": "640px", "$description": "Longest comfortable line of text." }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius. 6 px is the maximum on product surfaces.",
    "sm": { "$value": "3px" },
    "md": { "$value": "4px" },
    "lg": { "$value": "6px" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "focus": { "$value": "2px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "modal": {
      "$value": { "color": "#00000080", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" },
      "$description": "The only shadow, under a modal."
    }
  },
  "opacity": {
    "$type": "number",
    "muted": { "$value": 0.6 },
    "hairline": { "$value": 0.25 },
    "disabled": { "$value": 0.4 }
  },
  "z": {
    "$type": "number",
    "$description": "Stacking layers.",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "nav": { "$value": 20 },
    "banner": { "$value": 30 },
    "overlay": { "$value": 40 },
    "modal": { "$value": 50 },
    "toast": { "$value": 60 }
  },
  "viewport": {
    "$type": "dimension",
    "$description": "The device each surface is designed for.",
    "phone": { "width": { "$value": "390px" }, "height": { "$value": "844px" } },
    "tablet": { "width": { "$value": "1180px" }, "height": { "$value": "820px" } },
    "console": { "width": { "$value": "1440px" }, "height": { "$value": "900px" } },
    "tv": { "width": { "$value": "1920px" }, "height": { "$value": "1080px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "phone": { "$value": "{viewport.phone.width}" },
    "tablet": { "$value": "{viewport.tablet.width}" },
    "console": { "$value": "{viewport.console.width}" },
    "tv": { "$value": "{viewport.tv.width}" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "state": { "$value": "200ms", "$description": "State changes only: a seat filling, a sheet sliding in." }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0, 0, 0.58, 1], "$description": "ease-out." }
    }
  },
  "icon": {
    "size": {
      "$type": "dimension",
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" },
      "lg": { "$value": "24px" },
      "xl": { "$value": "32px" }
    },
    "stroke": { "$type": "dimension", "$value": "1.5px", "$description": "Line icons, 1.5 px stroke at every size." }
  }
}
