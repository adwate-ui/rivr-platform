{
  "name": "@rivr/tokens",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./generated/ts/tokens.ts",
    "./tokens.css": "./generated/css/tokens.css",
    "./tailwind.css": "./generated/tailwind/theme.css",
    "./manifest-colors.json": "./generated/manifest/colors.json",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "node style-dictionary.config.mjs",
    "check:generated": "node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "style-dictionary": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
