{
  "name": "@rivr/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./qr-code": "./src/QrCode/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "storybook": "node scripts/fonts.mjs && storybook dev --port ${RIVR_STORYBOOK_PORT:-6006} --no-open",
    "build-storybook": "node scripts/fonts.mjs && storybook build --quiet",
    "visual": "node visual/run.mjs",
    "build": "node scripts/fonts.mjs && tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@rivr/i18n": "workspace:*",
    "@rivr/tokens": "workspace:*",
    "lucide-react": "^1.59.0",
    "uqr": "0.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.11.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
