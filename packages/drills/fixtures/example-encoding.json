  "principles": [
    {
      "id": "pr_btn_rfi",
      "source_id": "src_example",
      "name": "Button raise-first-in",
      "page_ref": 0,
      "tier": "foundation",
      "rule": {
        "kind": "range_lookup",
        "situation": {
          "street": "preflop",
          "hero_position": ["BTN"],
          "preflop_facing_state": ["unopened"],
          "stack_bracket": ["standard", "deep"]
        },
        "range_set_id": "rs_btn_open",
        "in_range": { "action": "raise", "sizing": "medium", "feedback": { "correct": "On the button opening list, so it is raised." } },
        "out_of_range": { "action": "fold", "sizing": "unspecified", "feedback": { "correct": "Not on the button opening list — a third of hands are, two thirds are not — so it is folded." } }
      },
      "modifiers": [
        {
          "id": "mod_loose_game",
          "label": "Widen in loose-passive games",
          "when": { "game_texture": "loose_passive" },
          "effect": { "substitute_range_set_id": "rs_btn_open_wide" }
        }
      ],
      "exceptions": [],
      "rationale": "Position is the dominant variable preflop. Acting last on every subsequent street converts marginal holdings into playable ones, so the button range widens well past what the same hands justify from earlier seats.",
      "feedback": {
        "correct": "Right — position is doing the work here, not the raw strength of the holding.",
        "too_loose": "This is outside the opening range even on the button. Widening past the range costs more in dominated spots than position recovers.",
        "too_tight": "You can open this profitably from the button. Folding here leaves the blinds uncontested for no reason.",
        "too_passive": "Limping surrenders the initiative and invites the blinds in cheaply. Raise or fold.",
        "wrong_sizing": "Sizing is off for an unopened pot from late position."
      },
      "confidence": "high",
      "status": "active",
      "drillable": true
    },

    {
      "id": "pr_flop_cbet_dry_vs_station",
      "source_id": "src_example",
      "name": "Flop continuation bet on dry boards against a station",
      "page_ref": 0,
      "tier": "foundation",
      "prerequisites": ["pr_btn_rfi"],
      "rule": {
        "kind": "predicate",
        "situation": {
          "street": "flop",
          "hero_position": ["BTN"],
          "pot_type": ["single_raised"],
          "player_count": ["heads_up"],
          "postflop_facing_state": ["facing_check"],
          "villain_types": ["opp_station"],
          "board_require": ["rainbow", "disconnected"],
          "board_exclude": ["paired"],
          "node_path": ["hero_preflop_raise", "villain_preflop_call"]
        },
        "branches": [
          {
            "when": { "hand_class_any": ["top_pair_good_kicker", "overpair", "two_pair", "set"] },
            "then": { "action": "bet", "sizing": "medium", "feedback": { "correct": "A hand worse hands call: bet it for value, at a size they will pay." } }
          },
          {
            "when": {
              "hand_class_any": ["no_pair"],
              "draw_class_any": ["backdoor_flush", "backdoor_straight", "gutshot"]
            },
            "then": { "action": "bet", "sizing": "small", "feedback": { "correct": "A small bet with a little equity: cheap enough that the station's call costs you nothing you cannot outdraw." } }
          },
          {
            "when": { "hand_class_any": ["no_pair"], "draw_class_any": ["none"] },
            "then": { "action": "check", "sizing": "unspecified", "feedback": { "correct": "Nothing and no draw against a player who does not fold: the bet cannot win, so it is not made." } }
          }
        ],
        "default": { "action": "check", "sizing": "unspecified", "feedback": { "correct": "Against a station a bet is a value bet or nothing; this hand is not a value bet." } }
      },
      "exceptions": [
        {
          "when": { "stack_bracket": ["very_deep"] },
          "then": { "action": "bet", "sizing": "small", "feedback": { "correct": "Very deep, the small size keeps the pot manageable across three streets of a player who will not fold." } },
          "note": "Very deep, the small size keeps the pot manageable across three streets of a player who will not fold."
        }
      ],
      "rationale": "Against an opponent who calls too wide and folds too rarely, a continuation bet stops functioning as a bluff and starts functioning as a thin value bet. Bet the hands that get called by worse; check the ones that only get called by better.",
      "feedback": {
        "correct": "Right — against this opponent the bet is earning value, not fold equity.",
        "too_aggressive": "Bluffing a player who does not fold is spending money to reach a showdown you were going to lose anyway.",
        "too_passive": "This holding gets called by worse often enough to bet. Checking gives up value against a station.",
        "wrong_sizing": "Against a caller, sizing should track how much worse he will pay, not how much you want to fold him out.",
        "right_idea_wrong_spot": "The read is right but this board texture changes which holdings are ahead of his calling range."
      },
      "confidence": "medium",
      "status": "active",
      "drillable": true
    }
  ],

